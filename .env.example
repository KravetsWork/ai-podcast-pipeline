# ==========================================
# AI Podcast Pipeline - Settings
# Copy this file to .env and adjust to your preferences.
# ==========================================

# --- Edge-TTS Voice & Audio Settings ---
# Run 'python pipeline.py list-voices --filter uk' to see available voices
# Ukrainian examples: uk-UA-PolinaNeural, uk-UA-OstapNeural
# English examples: en-US-AndrewMultilingualNeural, en-US-BrianMultilingualNeural, en-US-EmmaNeural
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
# How many script files to synthesize in parallel during `run-all` and `watch`
MAX_JOBS=4

# --- ID3 Metadata Tagging Settings ---
DEFAULT_ARTIST=AI
DEFAULT_ALBUM_ARTIST=AI
DEFAULT_ALBUM=AI Podcasts
DEFAULT_GENRE=Podcast

# --- Directory Paths (Relative to project root or Absolute) ---
SCRIPT_DIR=Podcasts/Script
AUDIO_DIR=Podcasts/Audio

# --- Archive Settings ---
# If true, a script is moved to DONE_DIR after it was processed and published,
# so only new scripts remain in SCRIPT_DIR.
MOVE_TO_DONE=true
DONE_DIR=Podcasts/Script/Done

# --- Telegram Bot Publishing (Optional) ---
# If left empty, audio will be generated and tagged locally without sending to Telegram.
# 1. Create a bot with @BotFather to get your TELEGRAM_BOT_TOKEN
# 2. Get your group/channel ID (e.g. -100xxxxxxxxxx or @your_channel_name)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Telegram caption settings
TELEGRAM_CAPTION_PREFIX=🎙 *New podcast episode*
# Note: Keep hashtags inside quotes so that ' #tag' isn't treated as an inline comment by dotenv
TELEGRAM_INCLUDE_HASHTAGS="#podcast #AI"
